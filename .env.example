# 服务端口（建议由 Nginx/1Panel 反代，进程只监听本机）
PORT=8080

# 生产必须设为 release（会强制校验 JWT / 微信支付，并关闭 Swagger）
# GIN_MODE=release
# 如需临时打开文档：ENABLE_SWAGGER=true

# MySQL（生产请用最小权限账号，勿用 root）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=yujixinjiang
DB_PASSWORD=your_strong_password
DB_NAME=yujixinjiang

# JWT 密钥（生产至少 32 字符随机串，禁止使用示例值）
# 生成示例: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 支付渠道：开发可用 mock；生产必须 wechat 且 WECHAT_PAY_ENABLED=true
PAYMENT_PROVIDER=mock
WECHAT_PAY_ENABLED=false
WECHAT_MCH_ID=
# APIv3 密钥（32 字符，商户平台「API安全 → APIv3密钥」，不是 APIv2 密钥）
WECHAT_PAY_API_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_CERT_PATH=/opt/yujixinjiang/certs/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=/opt/yujixinjiang/certs/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://weixin.catmicloud.cn/api/payments/wechat/notify
PAY_TIMEOUT_MINUTES=5

# 数据库定时备份（需本机安装 mysqldump / mysql-client）
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_INTERVAL=24h
BACKUP_RETAIN_DAYS=7
BACKUP_COMPRESS=true

UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_PUBLIC_BASE=https://weixin.catmicloud.cn
AVATAR_PUBLIC_BASE=https://weixin.catmicloud.cn
UPLOAD_MAX_MB=10

# 腾讯位置服务 Key（配送范围地标检索用，留空则该功能不可用）
TENCENT_MAP_KEY=
