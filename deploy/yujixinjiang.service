[Unit]
Description=Yujixinjiang API
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/yujixinjiang
EnvironmentFile=/opt/yujixinjiang/.env
ExecStart=/opt/yujixinjiang/bin/server
Restart=always
RestartSec=3
LimitNOFILE=65535
# 证书与密钥仅进程用户可读
UMask=0077

[Install]
WantedBy=multi-user.target
