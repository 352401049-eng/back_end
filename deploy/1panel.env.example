# 复制到服务器 /opt/yujixinjiang/.env 后填写真实值
# 带 CHANGE_ME 的必须改；其余可按需调整

GIN_MODE=release
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=yujixinjiang
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=yujixinjiang

# 生成示例: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET

WECHAT_APPID=CHANGE_ME
WECHAT_SECRET=CHANGE_ME

PAYMENT_PROVIDER=wechat
WECHAT_PAY_ENABLED=true
WECHAT_MCH_ID=CHANGE_ME
WECHAT_PAY_API_KEY=CHANGE_ME_32_CHARS
WECHAT_PAY_SERIAL_NO=CHANGE_ME
WECHAT_PAY_CERT_PATH=/opt/yujixinjiang/certs/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=/opt/yujixinjiang/certs/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.yujixinjiang.cn/api/payments/wechat/notify
PAY_TIMEOUT_MINUTES=5

BACKUP_ENABLED=true
BACKUP_DIR=/opt/yujixinjiang/backups
BACKUP_INTERVAL=24h
BACKUP_RETAIN_DAYS=14
BACKUP_COMPRESS=true

# 每周邮件发送加密备份 ZIP（密码见 BACKUP_EMAIL_ZIP_PASSWORD）
BACKUP_EMAIL_ENABLED=true
BACKUP_EMAIL_TO=
BACKUP_EMAIL_API_URL=https://www.catmicloud.cn/api/v1/email/send-attachment
BACKUP_EMAIL_API_KEY=
BACKUP_EMAIL_INTERVAL=168h
BACKUP_EMAIL_ZIP_PASSWORD=
BACKUP_EMAIL_SUBJECT=雨季新江数据库备份

UPLOAD_DIR=/opt/yujixinjiang/uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_PUBLIC_BASE=https://api.yujixinjiang.cn
AVATAR_PUBLIC_BASE=https://api.yujixinjiang.cn
UPLOAD_MAX_MB=10

TENCENT_MAP_KEY=
